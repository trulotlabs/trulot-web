{
  "schemaVersion": 1,
  "datasetId": "parcel_base_sangis_v2",
  "status": "FUTURE_CONTRACT_ONLY",
  "sourceProfile": "sandag-parcels-geojson-v1",
  "sourceUrl": "https://geo.sandag.org/server/rest/services/Hosted/Parcels/FeatureServer/0",
  "metadataUrl": "https://geo.sandag.org/server/rest/services/Hosted/Parcels/FeatureServer/0/metadata",
  "sourceFields": {
    "objectid": "integer",
    "apn": "string",
    "parcelid": "integer",
    "situs_address": "integer",
    "situs_pre_dir": "string",
    "situs_street": "string",
    "situs_suffix": "string",
    "situs_post_dir": "string",
    "situs_fraction": "string",
    "situs_building": "string",
    "situs_suite": "string",
    "situs_zip": "string",
    "situs_juris": "string",
    "acreage": "number"
  },
  "nativeCrs": "EPSG:2230",
  "inputCrs": "EPSG:4326",
  "areaCrs": "EPSG:2230",
  "outputCrs": "EPSG:4326",
  "coordinateOrder": "longitude,latitude",
  "dimensions": 2,
  "apnPolicy": "exact-10-digits-or-3-3-2-2; no padding/truncation; preserve subunit",
  "duplicatePolicy": "quarantine-all-repeated-apns-and-objectids; never merge",
  "stackedPolicy": "retain-distinct-apns-even-with-identical-parcelid-and-geometry",
  "addressPolicy": "compose-present-components; missing-number-or-street-means-null; retain-raw-components",
  "geometryPolicy": "reject-null-empty-invalid-nonpolygon-or-nonfinite; no automatic repair; preserve multipart/holes",
  "areaPolicy": "derive-approximate-geometry-area-in-US-survey-square-feet; acreage-is-taxable-not-legal-lot-area",
  "centroidPolicy": "derive-in-2230-then-transform-to-4326; report-centroidWithin; retain-separate-pointOnSurface",
  "extraFieldPolicy": "report-names-and-exclude-from-normalized-base; retain-original-artifact",
  "jurisdictionCodes": [
    "CB",
    "CN",
    "CO",
    "CV",
    "DM",
    "EC",
    "EN",
    "ES",
    "IB",
    "LG",
    "LM",
    "NC",
    "OC",
    "PW",
    "SD",
    "SM",
    "SO",
    "ST",
    "VS"
  ],
  "regionalSanityBounds": [
    -118,
    32,
    -115.5,
    34
  ],
  "boundsMeaning": "Broad QA guard only, not a municipal or county boundary test",
  "countsPolicy": "input=accepted+rejected; duplicateRows subset of rejected; merged=0",
  "samplingPolicy": "first-3-by-sha256(contentSha256+colon+sourceObjectId), numeric-id-tiebreak",
  "toolchain": {
    "shapely": "2.1.2",
    "geos": "3.13.1",
    "pyproj": "3.7.2",
    "proj": "9.5.1"
  },
  "productionReady": false
}
